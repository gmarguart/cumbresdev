# Copia este archivo como .env.local y vuelve a compilar (npm run build).
# Estos valores se incrustan en el index.html generado: NO pongas aquí claves secretas.
# Los correos del formulario se configuran en public/enviar-contacto.php.

NEXT_PUBLIC_SITE_URL=https://cumbresdev.cl
# Formato internacional sin "+" ni espacios, ej. 569XXXXXXXX. Vacío = se oculta WhatsApp.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Correo público de contacto. Vacío = no se muestra.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
